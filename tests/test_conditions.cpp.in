// The .cpp.in suffix keeps this standalone main out of AC's recursive source collection.
#include "QuestieBridgeConditions.h"

#include <iostream>
#include <set>
#include <stdexcept>
#include <vector>

namespace
{
void Require(bool condition, char const* message)
{
    if (!condition)
        throw std::runtime_error(message);
}

void TestConditionLockedQuests()
{
    std::vector<std::uint32_t> const quests{11123, 7848, 8411, 960};
    std::set<std::uint32_t> const open{7848};
    std::set<std::uint32_t> const disabled{960};
    auto const locked = QuestieBridge::ConditionLockedQuests(quests,
        [&](std::uint32_t id) { return open.contains(id); }, [&](std::uint32_t id) { return disabled.contains(id); });
    Require(locked == std::set<std::uint32_t>{11123, 8411}, "closed quests are reported, open ones are not");
    Require(!locked.contains(960), "server-wide disables are not repeated");
}

void TestHiddenGivers()
{
    std::vector<std::uint32_t> const started{11123, 11124};
    auto none = [](std::uint32_t) { return false; };
    auto all = [](std::uint32_t) { return true; };
    Require(QuestieBridge::HiddenGiverHasVisibleQuest(started, none), "hidden NPC offers none despite its flag");
    Require(!QuestieBridge::HiddenGiverHasVisibleQuest(started, all), "hidden NPC with hidden quests adds nothing");
    Require(QuestieBridge::HiddenGiverHasVisibleQuest(started, [](std::uint32_t id) { return id == 11123; }),
        "one open quest keeps a hidden NPC reported");
}
}

int main()
{
    TestConditionLockedQuests();
    TestHiddenGivers();
    std::cout << "Questie bridge condition regressions passed\n";
}
